generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  clerkUserId   String?       @unique
  name          String?
  email         String        @unique
  password      String?
  image         String?
  role          Role          @default(USER)
  orders        Order[]
  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  bulkInquiries BulkInquiry[]
  couponUsages  CouponUsage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  city      String
  state     String
  zip       String
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  image         String?
  isActive      Boolean       @default(true)
  subcategories Subcategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive   Boolean   @default(true)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([slug, categoryId])
}

model Product {
  id               String       @id @default(cuid())
  name             String
  description      String
  price            Int               // Stored in paise (currency * 100)
  discountPrice    Int?              // Optional discounted price in paise
  gstPercent       Int               @default(5)
  stock            Int               @default(0)
  category         String            // Legacy string field — kept for backward compat
  subcategory      String?           // Legacy string field — kept for backward compat
  categoryId       String?           // New relational FK
  subcategoryId    String?           // New relational FK
  categoryRel      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryRel   Subcategory?      @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  sku              String?           @unique // Stock‑keeping unit, unique if present
  material         String?           // Material description
  dimensions       String?           // e.g., "10x20x5 cm"
  height           Float?            // Height in cm
  width            Float?            // Width/Breadth in cm
  length           Float?            // Length in cm
  diameter         Float?            // Diameter in cm
  weight           Float?            // Weight in kg/g
  sizeCategory     String?           // Small, Medium, Large, Extra Large, Standard, Custom
  tags             String[]          // Array of tags/keywords
  moq              Int?              // Minimum Order Quantity for bulk
  bulkPricingTiers Json?             // [{ qty: number, price: number }]
  variants         Json?             // Size-specific dimensions/prices
  attributes       Json?             // [{ name: string, value: string }]
  image            String
  subImages        String[]          @default([])
  video            String?           // Optional URL to product video
  rating           Float             @default(0)
  reviewCount      Int               @default(0)
  featured         Boolean           @default(false)
  bulkInquiryItems BulkInquiryItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean           @default(true)
  brand            String?           // Brand assignment
  shippingFee      Int?              // Optional shipping fee in paise
  shippingMethod   String?           // Optional shipping method assignment

  @@index([category])
  @@index([subcategory])
  @@index([material])
  @@index([featured])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  totalAmount     Int
  subtotalAmount  Int         @default(0)  // Base prices sum (no GST, no shipping)
  gstAmount       Int         @default(0)  // Total GST collected
  shippingAmount  Int         @default(9900) // Shipping in paise (default ₹99)
  discountAmount  Int         @default(0)  // Coupon discount in paise
  couponCode      String?     // Applied coupon code
  status          OrderStatus @default(PENDING)
  razorpayId      String?     @unique
  paymentStatus   String      @default("PENDING")
  shippingAddrId  String?
  items           OrderItem[]
  usages          CouponUsage[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int     // Final price per unit (basePrice + GST) in paise
  basePrice Int     @default(0) // Base price without GST in paise
  size      String  @default("")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model TraditionVideo {
  id        String   @id @default(cuid())
  videoUrl  String
  title     String
  thumbnail String?
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int
  size      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, size])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([wishlistId, productId])
}

model BulkInquiry {
  id                  String            @id @default(cuid())
  userId              String?           // Nullable for guest inquiries
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName        String
  companyName         String?
  mobile              String
  email               String
  gstNumber           String?
  deliveryLocation    String
  specialRequirements String?
  preferredContact    String            // "EMAIL" | "WHATSAPP" | "PHONE"
  status              String            @default("PENDING") // PENDING, CONTACTED, QUOTATION_SENT, APPROVED, REJECTED, COMPLETED
  adminNotes          String?
  negotiatedPrice     Int?              // Custom negotiated pricing in paise
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               BulkInquiryItem[]
}

model BulkInquiryItem {
  id         String      @id @default(cuid())
  inquiryId  String
  productId  String
  quantity   Int
  inquiry    BulkInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BulkImportLog {
  id              String   @id @default(cuid())
  adminEmail      String   // email of admin who performed the upload
  fileName        String   // original uploaded file name
  totalRows       Int
  successCount    Int
  failedCount     Int
  duplicateCount  Int
  createdAt       DateTime @default(now())
}

model StoreSettings {
  id                String   @id @default("default")
  razorpayKeyId     String?
  razorpayKeySecret String?
  shippingFee       Int      @default(9900) // Shipping fee in paise (default ₹99)
  updatedAt         DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  page      String   // e.g., "home", "about", "global"
  section   String   // e.g., "hero_banners", "trust_badges", "testimonials"
  key       String   // e.g., "banner_1_title", or JSON structure key
  value     String   @db.Text // Stores text, URL, or JSON string
  type      String   @default("TEXT") // "TEXT", "IMAGE", "JSON"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, section, key])
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BOGO
}

enum CouponEligibility {
  EVERYONE
  NEW_USER
}

model Coupon {
  id                    String            @id @default(cuid())
  code                  String            @unique
  description           String?
  type                  CouponType
  value                 Int               // Discount amount in paise OR percentage (e.g. 20 for 20%)
  
  // Validation Rules
  minOrderAmount        Int?              // Minimum subtotal required in paise
  maxDiscount           Int?              // Maximum discount allowed in paise (useful for PERCENTAGE)
  
  // Date Limits
  startDate             DateTime          @default(now())
  endDate               DateTime?         // Null means never expires
  
  // Usage Limits
  usageLimit            Int?              // Total number of times this coupon can be used globally
  usageCount            Int               @default(0) // How many times it has been used
  perUserLimit          Int               @default(1) // Max times a single user can use it
  
  // Inclusions/Exclusions
  applicableCategoryIds String[]          @default([]) // Empty means all categories
  applicableProductIds  String[]          @default([]) // Empty means all products
  excludedCategoryIds   String[]          @default([])
  excludedProductIds    String[]          @default([])
  
  // Status and Metadata
  eligibility           CouponEligibility @default(EVERYONE)
  isActive              Boolean           @default(true)
  autoApply             Boolean           @default(false)
  campaignName          String?           // For grouping in admin analytics
  
  usages                CouponUsage[]
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id              String   @id @default(cuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount  Int      // Amount discounted in paise
  createdAt       DateTime @default(now())
  
  @@unique([userId, orderId])
  @@index([couponId])
  @@index([userId])
}
