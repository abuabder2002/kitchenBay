# ==============================================================================
# KITCHENBAY PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' or add these keys to your hosting platform 
# (e.g. Vercel environment variables settings). Never commit actual secret keys 
# to a public Git repository.

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONNECTION (PostgreSQL - Neon / Managed DB)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with SSL required for production security.
DATABASE_URL="postgresql://[prod-username]:[prod-password]@[prod-host]/[prod-dbname]?sslmode=require"

# ------------------------------------------------------------------------------
# 👤 AUTHENTICATION & ACCESS (Clerk - Live Keys)
# ------------------------------------------------------------------------------
# Live Keys from the Clerk production instance. Test keys (starting with pk_test_) 
# will not allow custom domain sessions to function correctly.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_YOUR_LIVE_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_live_YOUR_LIVE_SECRET_KEY"

# Primary admin email. Signing into Clerk with this email gives full B2B 
# Wholesale dashboard, CRM panel, and product catalog management capabilities.
NEXT_PUBLIC_ADMIN_EMAIL="admin@kitchenbay.in"

# Clerk Application Redirect Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ------------------------------------------------------------------------------
# 💳 PAYMENT GATEWAY (Razorpay - Live Keys)
# ------------------------------------------------------------------------------
# Production Keys starting with 'rzp_live_'. Test keys (rzp_test_) will reject
# live transactions.
RAZORPAY_KEY_ID="rzp_live_YOUR_LIVE_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_LIVE_RAZORPAY_SECRET"

# ------------------------------------------------------------------------------
# 🚀 UPSTASH REDIS (Production Cache & KV)
# ------------------------------------------------------------------------------
# Setup a production Redis instance on Upstash to support low-latency caching
# and secure rate-limiting.
KV_URL="redis://default:YOUR_REDIS_PASSWORD@YOUR_UPSTASH_ENDPOINT:30000"
KV_REST_API_URL="https://YOUR_UPSTASH_REST_API_URL"
KV_REST_API_TOKEN="YOUR_UPSTASH_REST_API_TOKEN"

# ------------------------------------------------------------------------------
# ☁️ CLOUDINARY (Media & Image Uploads)
# ------------------------------------------------------------------------------
# Production Cloudinary keys for hosting uploaded catalog images and videos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# ------------------------------------------------------------------------------
# 📧 TRANSACTIONAL EMAILS (Gmail SMTP or dedicated SMTP provider)
# ------------------------------------------------------------------------------
# Configurations for automated B2B order confirmations, admin notification alerts,
# and customer tracking emails.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@kitchenbay.in"
# Use a Gmail App Password (16 characters) rather than your main account password.
SMTP_PASSWORD="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM="Kitchenbay Alerts <notifications@kitchenbay.in>"
